# API Configuration (Optional - for backend integration)
NEXT_PUBLIC_API_URL=https://your-api-endpoint.com

# Redis Configuration (Optional - for caching/sessions)
REDIS_URL=redis://localhost:6379

# Database Configuration (Optional - for PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/erp_db

# Email Service (Optional - for email campaigns)
SENDGRID_API_KEY=your_sendgrid_key

# WhatsApp Business API (Optional - for WhatsApp campaigns)
WHATSAPP_API_KEY=your_whatsapp_key
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Authentication (Optional - for NextAuth.js)
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
